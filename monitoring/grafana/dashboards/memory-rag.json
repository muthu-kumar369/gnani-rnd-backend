{
    "dashboard": {
        "title": "Gnani Memory & RAG",
        "tags": [
            "gnani",
            "memory",
            "rag"
        ],
        "timezone": "browser",
        "schemaVersion": 16,
        "version": 0,
        "refresh": "10s",
        "panels": [
            {
                "id": 1,
                "title": "Vector Search Latency",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(vector_search_duration_seconds_bucket[5m]))",
                        "legendFormat": "{{collection}}",
                        "refId": "A"
                    }
                ]
            },
            {
                "id": 2,
                "title": "Embedding Generation Time",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(embedding_generation_duration_seconds_bucket[5m]))",
                        "legendFormat": "p95",
                        "refId": "A"
                    }
                ]
            },
            {
                "id": 3,
                "title": "Memory Retrievals",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "rate(memory_retrieval_total[5m])",
                        "legendFormat": "{{type}}",
                        "refId": "A"
                    }
                ]
            },
            {
                "id": 4,
                "title": "Summarizations",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "rate(summarization_total[5m])",
                        "legendFormat": "{{type}}",
                        "refId": "A"
                    }
                ]
            }
        ]
    }
}