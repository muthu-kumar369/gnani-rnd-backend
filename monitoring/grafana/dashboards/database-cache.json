{
    "dashboard": {
        "title": "Gnani Database & Cache",
        "tags": [
            "gnani",
            "database",
            "cache"
        ],
        "timezone": "browser",
        "schemaVersion": 16,
        "version": 0,
        "refresh": "10s",
        "panels": [
            {
                "id": 1,
                "title": "Database Query Duration",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(db_query_duration_seconds_bucket[5m]))",
                        "legendFormat": "{{operation}} - {{collection}}",
                        "refId": "A"
                    }
                ]
            },
            {
                "id": 2,
                "title": "Database Connection Pool",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "db_connection_pool_size",
                        "legendFormat": "{{state}}",
                        "refId": "A"
                    }
                ]
            },
            {
                "id": 3,
                "title": "Redis Operation Duration",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(redis_operation_duration_seconds_bucket[5m]))",
                        "legendFormat": "{{operation}}",
                        "refId": "A"
                    }
                ]
            },
            {
                "id": 4,
                "title": "Redis Memory Usage",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "redis_memory_bytes / 1024 / 1024",
                        "legendFormat": "Memory (MB)",
                        "refId": "A"
                    }
                ]
            }
        ]
    }
}