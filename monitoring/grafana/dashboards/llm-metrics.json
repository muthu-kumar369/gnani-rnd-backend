{
    "dashboard": {
        "title": "Gnani LLM Metrics",
        "tags": [
            "gnani",
            "llm"
        ],
        "timezone": "browser",
        "panels": [
            {
                "title": "LLM Request Latency",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(llm_request_duration_seconds_bucket[5m]))",
                        "legendFormat": "p95 Latency"
                    }
                ]
            },
            {
                "title": "Token Usage",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "rate(llm_tokens_total{type=\"input\"}[5m])",
                        "legendFormat": "Input Tokens/s"
                    },
                    {
                        "expr": "rate(llm_tokens_total{type=\"output\"}[5m])",
                        "legendFormat": "Output Tokens/s"
                    }
                ]
            },
            {
                "title": "LLM Requests per Minute",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 0,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "sum(rate(llm_requests_total[1m])) * 60",
                        "legendFormat": "Requests/min"
                    }
                ]
            },
            {
                "title": "Estimated Cost ($/hour)",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 6,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "sum(rate(llm_cost_dollars[1h])) * 3600",
                        "legendFormat": "$/hour"
                    }
                ]
            },
            {
                "title": "Cache Hit Rate",
                "type": "gauge",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 12,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "rate(llm_cache_hits[5m]) / (rate(llm_cache_hits[5m]) + rate(llm_cache_misses[5m])) * 100",
                        "legendFormat": "Hit Rate %"
                    }
                ]
            },
            {
                "title": "Provider Distribution",
                "type": "piechart",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 18,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "sum(rate(llm_requests_total[5m])) by (provider)",
                        "legendFormat": "{{provider}}"
                    }
                ]
            }
        ]
    }
}