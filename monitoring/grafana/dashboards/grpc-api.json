{
    "dashboard": {
        "title": "Gnani gRPC & API",
        "tags": [
            "gnani",
            "grpc",
            "api"
        ],
        "timezone": "browser",
        "schemaVersion": 16,
        "version": 0,
        "refresh": "10s",
        "panels": [
            {
                "id": 1,
                "title": "gRPC Request Rate",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "rate(grpc_request_total[5m])",
                        "legendFormat": "{{method}} - {{status}}",
                        "refId": "A"
                    }
                ]
            },
            {
                "id": 2,
                "title": "gRPC Request Duration",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(grpc_request_duration_seconds_bucket[5m]))",
                        "legendFormat": "{{method}}",
                        "refId": "A"
                    }
                ]
            },
            {
                "id": 3,
                "title": "WebSocket Connections",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 0,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "websocket_connections_active",
                        "refId": "A"
                    }
                ]
            },
            {
                "id": 4,
                "title": "Rate Limit Exceeded",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 18,
                    "x": 6,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "rate(rate_limit_exceeded_total[5m])",
                        "legendFormat": "{{endpoint}}",
                        "refId": "A"
                    }
                ]
            }
        ]
    }
}