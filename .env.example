# Environment variables for GNANI Backend

# Server Configuration
PORT=3000
GRPC_PORT=50051

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/gnani_db

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_here

# LLM Service Configuration
LLM_SERVER_URL=http://localhost:8080
LLM_MODEL_PATH=llama2
LLM_API_KEY=your_llm_api_key_here
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_STREAMING_ENABLED=true

# Whisper (ASR) Configuration
WHISPER_MODEL_PATH=base
WHISPER_LANGUAGE=en
WHISPER_SAMPLE_RATE=16000
WHISPER_COMPUTE_TYPE=int8
WHISPER_PYTHON_PATH=python

# TTS Configuration
TTS_PYTHON_PATH=python
TTS_ENGINE=coqui
TTS_VOICE=tts_models/en/ljspeech/vits
TTS_LANGUAGE=en
TTS_SAMPLE_RATE=22050
TTS_STREAM_CHUNK_SIZE=2048

# Vector Database (ChromaDB)
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=8000
COLLECTION_NAME=gnani_collection

# CORS Configuration (for Express.js)
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
LOG_FILE_ERROR=error.log
LOG_FILE_COMBINED=combined.log
