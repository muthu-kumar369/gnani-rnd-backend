# Environment Configuration Template for Gnani Backend
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
GRPC_PORT=50051
LOG_LEVEL=debug
LOG_FILE_ERROR=logs/error.log
LOG_FILE_COMBINED=logs/combined.log

# LLM Configuration
LLM_SERVER_URL=http://localhost:11434
LLM_MODEL_PATH=./models/llm-model.gguf
LLM_API_KEY=your_llm_api_key_here
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.7
LLM_STREAMING_ENABLED=true

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/gnani

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=supersecretjwtkey
JWT_ENCRYPTION_SECRET=supersecretjwtokencryptionkeylongenough

# OAuth Configuration - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/callback

# OAuth Configuration - Apple
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key
APPLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/callback

# OAuth Configuration - GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/oauth/callback

# OAuth Configuration - Microsoft
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/oauth/callback

# Whisper Configuration
WHISPER_MODEL_PATH=./models/whisper-medium.pt
WHISPER_LANGUAGE=en
WHISPER_SAMPLE_RATE=16000
WHISPER_COMPUTE_TYPE=float16
WHISPER_PYTHON_PATH=./.venv/bin/python

# TTS Configuration
TTS_ENGINE=coqui-tts
TTS_VOICE=en_US/cmu-arctic_slt
TTS_LANGUAGE=en
TTS_SAMPLE_RATE=22050
TTS_STREAM_CHUNK_SIZE=1024
TTS_PYTHON_PATH=./.venv/bin/python

# System Configuration
ALLOWED_ACTIONS={"OPEN_APP":true, "SEARCH_WEB":true, "SET_TIMER":true, "CONTROL_VOLUME":true}
MAX_CONCURRENT_SESSIONS=10
